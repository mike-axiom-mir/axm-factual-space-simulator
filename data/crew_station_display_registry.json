{
  "schema": "axm.crew-station-display-registry.v1",
  "registry_version": "0.14.0",
  "as_of_date": "2026-08-02",
  "display_rules": {
    "task_relevant_information_first": true,
    "critical_controls_grouped_with_related_displays": true,
    "current_mode_visible": true,
    "operational_limit_violations_visible": true,
    "stale_or_degraded_data_visible": true,
    "simulation_and_mission_modes_visually_distinct": true,
    "plain_language_explanation_available": true,
    "numeric_value_never_hidden_by_explanation": true,
    "unknown_is_not_rendered_as_zero": true
  },
  "alert_priorities": [
    {
      "id": "emergency",
      "symbol": "E",
      "semantic_color": "red"
    },
    {
      "id": "warning",
      "symbol": "W",
      "semantic_color": "red"
    },
    {
      "id": "caution",
      "symbol": "C",
      "semantic_color": "yellow"
    },
    {
      "id": "advisory",
      "symbol": "A",
      "semantic_color": "blue"
    }
  ],
  "alert_fields": [
    "priority",
    "event_id",
    "name",
    "timestamp",
    "system_id",
    "module_or_element",
    "active_state",
    "acknowledge_state",
    "data_quality",
    "root_cause_if_known",
    "procedure_link_if_available"
  ],
  "control_influences": [
    {
      "id": "load_shedding",
      "display_name": "Load shedding",
      "authorized_roles": [
        "vehicle_systems_engineer",
        "mission_commander",
        "ai_systems_integrator"
      ],
      "directly_influences": [
        "power.load",
        "power.margin",
        "power.shed_load_count",
        "thermal.waste_heat",
        "thermal.margin"
      ],
      "secondary_consequences": [
        "science.sensor_availability",
        "robotics.availability",
        "comms.queue_pct"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Engineering may shed reversible loads inside protected-load rules."
    },
    {
      "id": "vehicle_attitude",
      "display_name": "Vehicle attitude",
      "authorized_roles": [
        "flight_dynamics_navigation",
        "mission_commander"
      ],
      "directly_influences": [
        "nav.attitude_error",
        "nav.pointing_performance",
        "power.solar_flux",
        "comms.availability",
        "thermal.rejection"
      ],
      "secondary_consequences": [
        "science.sensor_availability",
        "hazard.external_heat"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Routine pointing is delegated; high-consequence attitude changes require command."
    },
    {
      "id": "sensor_selection",
      "display_name": "Navigation sensor selection",
      "authorized_roles": [
        "flight_dynamics_navigation",
        "ai_systems_integrator"
      ],
      "directly_influences": [
        "nav.uncertainty",
        "science.sensor_availability"
      ],
      "secondary_consequences": [
        "power.load",
        "thermal.waste_heat",
        "comms.queue"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Selection cannot lower uncertainty without validated measurements."
    },
    {
      "id": "compartment_isolation",
      "display_name": "Compartment isolation",
      "authorized_roles": [
        "vehicle_systems_engineer",
        "mission_commander"
      ],
      "directly_influences": [
        "life.pressure_loss_rate",
        "structure.isolated_rooms",
        "structure.boundary"
      ],
      "secondary_consequences": [
        "life.available_crew",
        "maintenance.work_orders"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Automatic isolation may protect life; reopening requires verification."
    },
    {
      "id": "data_priority",
      "display_name": "Data priority",
      "authorized_roles": [
        "communications_data_robotics",
        "science_anomaly_specialist",
        "mission_commander"
      ],
      "directly_influences": [
        "comms.queue",
        "comms.queue_pct"
      ],
      "secondary_consequences": [
        "science.raw_data_preserved"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Priority may change; unique raw evidence may not be silently deleted."
    },
    {
      "id": "robotic_operation",
      "display_name": "Robotic operation",
      "authorized_roles": [
        "communications_data_robotics",
        "science_anomaly_specialist"
      ],
      "directly_influences": [
        "robotics.health",
        "robotics.availability"
      ],
      "secondary_consequences": [
        "power.load",
        "thermal.waste_heat",
        "science.sensor_availability"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Irreversible contact or release has separate authority gates."
    },
    {
      "id": "science_observation_plan",
      "display_name": "Science observation plan",
      "authorized_roles": [
        "science_anomaly_specialist",
        "mission_commander",
        "ai_systems_integrator"
      ],
      "directly_influences": [
        "science.sensor_availability",
        "comms.queue",
        "power.load",
        "thermal.waste_heat"
      ],
      "secondary_consequences": [
        "nav.pointing_performance"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Observation plans cannot raise claim ceilings without evidence."
    },
    {
      "id": "crew_task_assignment",
      "display_name": "Crew task assignment",
      "authorized_roles": [
        "mission_commander",
        "crew_medical_officer"
      ],
      "directly_influences": [
        "crew.commander_workload",
        "crew.engineering_workload",
        "crew.science_workload",
        "crew.navigation_workload"
      ],
      "secondary_consequences": [
        "maintenance.repair_capacity",
        "life.available_crew"
      ],
      "irreversible": "operation_dependent",
      "authority_rule": "Medical restrictions and role qualification remain binding."
    }
  ],
